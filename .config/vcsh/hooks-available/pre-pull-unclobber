#!/bin/sh

repo_root="${VCSH_REPO_D:-$XDG_CONFIG_HOME/vcsh/repo.d}"
worktree="${VCSH_BASE:-$HOME}"
repo="$VCSH_REPO_NAME"
GIT_DIR="$repo_root/$repo.git"

[ -n "$repo" ] || exit 0
[ -d "$GIT_DIR" ] || exit 0

git --git-dir="$GIT_DIR" fetch -q origin >/dev/null 2>&1 || exit 0

head_ref="$(git --git-dir="$GIT_DIR" symbolic-ref -q HEAD 2>/dev/null || true)"
if [ -n "$head_ref" ]; then
  branch="${head_ref#refs/heads/}"
  upstream="refs/remotes/origin/$branch"
else
  upstream=""
fi

if [ -n "$upstream" ] && ! git --git-dir="$GIT_DIR" rev-parse -q --verify "$upstream" >/dev/null 2>&1; then
  upstream=""
fi

if [ -z "$upstream" ]; then
  upstream="$(git --git-dir="$GIT_DIR" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null || true)"
fi

if [ -z "$upstream" ]; then
  if git --git-dir="$GIT_DIR" rev-parse -q --verify refs/remotes/origin/main >/dev/null 2>&1; then
    upstream="refs/remotes/origin/main"
  elif git --git-dir="$GIT_DIR" rev-parse -q --verify refs/remotes/origin/master >/dev/null 2>&1; then
    upstream="refs/remotes/origin/master"
  else
    exit 0
  fi
fi

git --git-dir="$GIT_DIR" diff --name-only --diff-filter=ACMR HEAD "$upstream" 2>/dev/null | while IFS= read -r path; do
  [ -n "$path" ] || continue

  git --git-dir="$GIT_DIR" --work-tree="$worktree" ls-files --error-unmatch -- "$path" >/dev/null 2>&1 && continue

  src="$worktree/$path"
  dst="$src.vcsh-unclobber"

  [ -e "$src" ] || continue
  [ -e "$dst" ] && continue

  mv -- "$src" "$dst"
done

exit 0
