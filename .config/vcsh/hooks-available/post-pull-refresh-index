#!/bin/sh

# Re-stage tracked files so clean-filtered files do not show as modified by git status.
# `git update-index --refresh` short-circuits on size mismatch and skips the clean
# filter, leaving phantoms in place. `git add --update` re-runs the filter and
# rewrites the index entry's stat, which is what actually clears them. The diff
# guard prevents staging real user edits when the hook fires after a pull.

cd "${VCSH_BASE:-$HOME}" || exit 0

repo_d="${VCSH_REPO_D:-${XDG_CONFIG_HOME:-$HOME/.config}/vcsh/repo.d}"

for repo_git in "$repo_d"/*.git; do
  [ -d "$repo_git" ] || continue
  GIT_DIR="$repo_git" /usr/local/bin/git diff --quiet 2>/dev/null && \
    GIT_DIR="$repo_git" /usr/local/bin/git add --update >/dev/null 2>&1 || true
done
