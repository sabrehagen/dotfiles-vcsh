#!/bin/sh

# Re-stage tracked files so clean-filtered files do not show as modified by git status.
# `git update-index --refresh` short-circuits and skips the clean filter, leaving
# phantoms in place. `git add --update` re-runs the filter and rewrites the index
# entry's stat (size, mtime), which is what actually clears them. The diff guard
# prevents staging real user edits when the hook fires after a pull.

cd "$VCSH_BASE"
export GIT_DIR="$VCSH_REPO_D/$VCSH_REPO_NAME.git"
git diff --quiet && git add --update || :
