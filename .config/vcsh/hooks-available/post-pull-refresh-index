#!/bin/sh

# Refresh the git index stat cache after pull to prevent phantom diffs.
#
# When dotfiles are synced across machines, the index records stat metadata
# (mtime, ctime, inode, etc.) from the source machine. These don't match the
# local filesystem, so git reports files as modified even though content is
# identical. Refreshing the index re-stats all entries and clears the false
# positives, including entries that use clean filters.

cd "${VCSH_BASE:-$HOME}" || exit 0

repo_d="${VCSH_REPO_D:-${XDG_CONFIG_HOME:-$HOME/.config}/vcsh/repo.d}"

for repo_git in "$repo_d"/*.git; do
  [ -d "$repo_git" ] || continue
  GIT_DIR="$repo_git" /usr/local/bin/git update-index --refresh >/dev/null 2>&1 || true
done
