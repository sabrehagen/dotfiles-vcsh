#!/bin/sh

# After each vcsh pull, force-checkout all tracked files to match HEAD.
# This ensures the working tree stays in sync even when Docker volumes
# contain stale content from a previous container run.

cd "${VCSH_BASE:-$HOME}" || exit 0

repo_git="${VCSH_REPO_D:-${XDG_CONFIG_HOME:-$HOME/.config}/vcsh/repo.d}/$VCSH_REPO_NAME.git"

[ -d "$repo_git" ] || exit 0

GIT_DIR="$repo_git" git checkout -- . 2>/dev/null || true
