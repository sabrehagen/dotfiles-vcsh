#!/bin/sh

# Before a merge (including `vcsh clone`), move untracked files that would
# conflict with the incoming tree out of the way so the merge proceeds
# cleanly. Only untracked files are moved — tracked files are left alone
# because git autostash (rebase.autostash=true) handles them correctly.
# Moving a tracked file before autostash runs causes autostash to capture
# it as a local deletion, which then produces a spurious modify/delete
# conflict when the incoming commit updates the same file.

worktree="${VCSH_BASE:-$HOME}"
_ref="$(git symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null || echo refs/remotes/origin/master)"

git ls-tree -r --name-only "$_ref" | while IFS= read -r object; do
  src="$worktree/$object"
  [ -e "$src" ] || continue
  [ -e "$src.vcsh-unclobber" ] && continue
  # Never move a file git knows about. "Knows about" must mean in HEAD OR
  # in the index — index alone is too narrow, because any divergence
  # between the two (transient rebase state, interrupted earlier operation,
  # partial autostash pop) leaves real tracked files looking untracked to
  # ls-files and silently moves them out of the worktree.
  git cat-file -e "HEAD:$object" 2>/dev/null && continue
  git ls-files --error-unmatch -- "$object" >/dev/null 2>&1 && continue
  mv -- "$src" "$src.vcsh-unclobber"
done
