# For git checkout and git pull: move conflicting files to .vcsh-unclobber
# before the operation, then restore them after so they appear as unstaged
# changes for inspection.  Handles both untracked files and tracked files
# with local modifications.

run() {
	worktree="${VCSH_BASE:-$HOME}"

	# Match both "git" (vcsh run) and "/path/to/git" (vcsh shorthand) without a subshell
	case "$1" in git|*/git) _is_git=1 ;; *) _is_git=0 ;; esac

	# Resolve git aliases (e.g. p=pull) so we match on the canonical command name.
	# Only resolves simple aliases (not shell aliases starting with !).
	_cmd="$2"
	case "$_cmd" in
		pull|checkout) ;;
		*)
			_alias="$(git --git-dir="$GIT_DIR" config --get "alias.$_cmd" 2>/dev/null || true)"
			case "$_alias" in
				pull*)     _cmd="pull" ;;
				checkout*) _cmd="checkout" ;;
			esac
			;;
	esac

	_unclobber_target=""

	if [ "$_is_git" = "1" ] && [ "$_cmd" = "checkout" ]; then
		# Parse the target ref from the checkout args.
		# For -b/-B <new-branch> [<start-point>], skip the new branch name
		# so we land on the start point (where new files actually come from).
		_target=""
		_skip_next=0
		for _arg in "$@"; do
			if [ "$_skip_next" = "1" ]; then
				_skip_next=0
				continue
			fi
			case "$_arg" in
				git|*/git|checkout) ;;
				-b|-B|--orphan)     _skip_next=1 ;;
				--)                 break ;;
				-*)                 ;;
				*)                  _target="$_arg" ;;
			esac
		done

		# If target doesn't resolve locally, try origin/<target>
		# (handles: git checkout feature, where origin/feature exists)
		if [ -n "$_target" ] \
			&& ! git --git-dir="$GIT_DIR" rev-parse -q --verify "$_target" >/dev/null 2>&1; then
			_target="origin/$_target"
		fi

		if [ -n "$_target" ] \
			&& git --git-dir="$GIT_DIR" rev-parse -q --verify "$_target" >/dev/null 2>&1; then
			_unclobber_target="$_target"
		fi

	elif [ "$_is_git" = "1" ] && [ "$_cmd" = "pull" ]; then
		# Do NOT pre-fetch here. A separate fetch before pull doubles SSH sessions
		# (one pre-fetch + one from git pull itself), which overloads the SSH
		# ControlMaster and causes intermittent "Cannot rebase onto multiple branches"
		# failures. Use the locally cached remote ref instead — it reflects the last
		# pull and is accurate enough for the unclobber diff. If a brand-new remote
		# file conflicts with an untracked local file, git pull will report a clear
		# "untracked file would be overwritten" error; the next pull succeeds once
		# the cached ref is fresh.

		_head="$(git --git-dir="$GIT_DIR" symbolic-ref -q HEAD 2>/dev/null || true)"
		if [ -n "$_head" ]; then
			_branch="${_head#refs/heads/}"
			_upstream="refs/remotes/origin/$_branch"
			if git --git-dir="$GIT_DIR" rev-parse -q --verify "$_upstream" >/dev/null 2>&1; then
				_unclobber_target="$_upstream"
			fi
		fi
	fi

	# Move conflicting untracked files out of the way before the operation.
	# Only untracked files need this treatment — files that exist on disk but
	# are not in the current HEAD, so git's autostash won't protect them.
	# Tracked files (even locally modified ones) are left alone: autostash
	# captures their modifications cleanly, whereas moving them creates a
	# working-tree deletion that autostash captures as "delete", producing a
	# modify/delete conflict when the incoming commit updates the same file.
	if [ -n "$_unclobber_target" ]; then
		_merge_base="$(git --git-dir="$GIT_DIR" merge-base HEAD "$_unclobber_target" 2>/dev/null || true)"
		git --git-dir="$GIT_DIR" diff --name-only "${_merge_base:-HEAD}" "$_unclobber_target" 2>/dev/null \
			| while IFS= read -r path; do
				src="$worktree/$path"
				dst="$src.vcsh-unclobber"
				[ -e "$src" ] || continue
				[ -e "$dst" ] && continue
				# Skip tracked files — git autostash handles these correctly
				git --git-dir="$GIT_DIR" ls-files --error-unmatch -- "$path" >/dev/null 2>&1 && continue
				mv -- "$src" "$dst"
			done
	fi

	hook pre-run
	use
	"$@"
	VCSH_COMMAND_RETURN_CODE=$?
	hook post-run

	# Restore .vcsh-unclobber files regardless of outcome — leaving them
	# renamed on disk is worse than restoring after a failed operation.
	if [ -n "$_unclobber_target" ]; then
		git --git-dir="$GIT_DIR" ls-tree -r --name-only HEAD 2>/dev/null \
			| while IFS= read -r path; do
				src="$worktree/$path.vcsh-unclobber"
				dst="$worktree/$path"
				[ -e "$src" ] || continue
				mv -- "$src" "$dst"
			done
	fi

	return "$VCSH_COMMAND_RETURN_CODE"
}
