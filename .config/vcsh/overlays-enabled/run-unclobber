# Run before vcsh's "run" command (vcsh <repo> <git ...>).
# If the command is a git pull (or git p), unclobber potential conflicts.

if [ "$1" = "git" ] && { [ "$2" = "pull" ] || [ "$2" = "p" ]; }; then
  worktree="${VCSH_BASE:-$HOME}"
  git_dir_path="${GIT_DIR:-$VCSH_REPO_D/$VCSH_REPO_NAME.git}"

  [ -d "$git_dir_path" ] || return 0

  git --git-dir="$git_dir_path" fetch -q origin >/dev/null 2>&1 || true

  branch_ref="$(git --git-dir="$git_dir_path" symbolic-ref -q refs/remotes/origin/HEAD || true)"
  if [ -z "$branch_ref" ]; then
    if git --git-dir="$git_dir_path" rev-parse --verify -q refs/remotes/origin/master >/dev/null; then
      branch_ref="refs/remotes/origin/master"
    elif git --git-dir="$git_dir_path" rev-parse --verify -q refs/remotes/origin/main >/dev/null; then
      branch_ref="refs/remotes/origin/main"
    else
      return 0
    fi
  fi

  cd "$worktree" || return 0
  git --git-dir="$git_dir_path" ls-tree -r --name-only "$branch_ref" | while read -r object; do
    [ -e "$worktree/$object" ] && mv "$worktree/$object" "$worktree/$object.vcsh-unclobber"
  done
fi
