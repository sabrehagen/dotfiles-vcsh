# For vcsh pull (all repos): move any pre-existing untracked files at
# conflicting paths to .vcsh-unclobber before each repo's pull, then restore
# them after so they appear as unstaged changes for inspection.

pull() {
	worktree="${VCSH_BASE:-$HOME}"

	hook_global pre-pull
	for VCSH_REPO_NAME in $(list_has_remote); do
		export VCSH_REPO_NAME
		printf '%s: ' "$VCSH_REPO_NAME"
		GIT_DIR="$VCSH_REPO_D/$VCSH_REPO_NAME.git"; export GIT_DIR
		use

		# Fetch so the remote ref reflects what is actually incoming
		git --git-dir="$GIT_DIR" fetch -q origin 2>/dev/null || true

		_head="$(git --git-dir="$GIT_DIR" symbolic-ref -q HEAD 2>/dev/null || true)"
		_upstream=""
		if [ -n "$_head" ]; then
			_branch="${_head#refs/heads/}"
			_candidate="refs/remotes/origin/$_branch"
			if git --git-dir="$GIT_DIR" rev-parse -q --verify "$_candidate" >/dev/null 2>&1; then
				_upstream="$_candidate"
			fi
		fi

		# Move untracked files that the pull would clobber
		if [ -n "$_upstream" ]; then
			git --git-dir="$GIT_DIR" diff --name-only --diff-filter=A HEAD "$_upstream" 2>/dev/null \
				| while IFS= read -r path; do
					src="$worktree/$path"
					dst="$src.vcsh-unclobber"
					[ -e "$src" ] || continue
					[ -e "$dst" ] && continue
					git --git-dir="$GIT_DIR" ls-files --error-unmatch -- "$path" >/dev/null 2>&1 && continue
					mv -- "$src" "$dst"
				done
		fi

		hook_repo pre-pull
		/usr/local/bin/git pull
		VCSH_COMMAND_RETURN_CODE=$?
		hook_repo post-pull
		echo

		# Restore .vcsh-unclobber files after a successful pull
		if [ "$VCSH_COMMAND_RETURN_CODE" = "0" ] && [ -n "$_upstream" ]; then
			git --git-dir="$GIT_DIR" ls-tree -r --name-only HEAD 2>/dev/null \
				| while IFS= read -r path; do
					src="$worktree/$path.vcsh-unclobber"
					dst="$worktree/$path"
					[ -e "$src" ] || continue
					mv -- "$src" "$dst"
				done
		fi
	done
	hook_global post-pull
}
